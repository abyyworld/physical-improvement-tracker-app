// Firestore rules for Arise. Paste these into Firebase console, Firestore Database, Rules, then Publish.
// Each signed-in person can read and write only their own folder (users/<their id>/...).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
