// Firestore rules for Arise. Deploy with `npx firebase-tools deploy --only firestore:rules`
// (see firebase.json), or paste into Firebase console, Firestore Database, Rules, then Publish.
//
// Each signed-in person can only reach their own folder (users/<their id>/arise/...), and only in
// the encrypted shape the app writes: the server refuses plain data, oversized documents and any
// other document names. It never holds anything it could read, except the data key of an account
// that chose Email reset (byEmail below): only that account can fetch it, but whoever runs this
// project could read it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    // AES-GCM output from the app: base64 IV and ciphertext.
    function sealed(v, max) {
      return v is map && v.keys().hasOnly(['iv', 'ct']) && shortString(v.iv, 24) && shortString(v.ct, max);
    }
    // A 256-bit key as it is, in base64.
    function rawKey(v) {
      return v is string && v.size() == 44 && v.matches('[A-Za-z0-9+/]{43}=');
    }

    // Which version is current, and the IV for its ciphertext.
    match /users/{uid}/arise/meta {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['rev', 'parts', 'enc', 'iv', 'schema'])
        && shortString(request.resource.data.rev, 32)
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 20
        && request.resource.data.enc == 1
        && shortString(request.resource.data.iv, 24)
        && request.resource.data.schema is int && request.resource.data.schema >= 1 && request.resource.data.schema <= 1000;
    }

    // The data key, wrapped by the password and by the recovery code. With Email reset, also as
    // it is (byEmail), so a password set from a reset email can open it again. `wasEmail: true`
    // says it has been kept so, now or before. (Anyone who gets into an account's email can set
    // a password and write these too, so the app never takes them on trust.)
    match /users/{uid}/arise/keys {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['v', 'iter', 'byPassword', 'byRecovery', 'byEmail', 'wasEmail'])
        && request.resource.data.v == 1
        && request.resource.data.iter is int
        && sealed(request.resource.data.byPassword, 200)
        && sealed(request.resource.data.byRecovery, 200)
        && (!('byEmail' in request.resource.data) || rawKey(request.resource.data.byEmail))
        && (!('wasEmail' in request.resource.data) || request.resource.data.wasEmail == true);
    }

    // The ciphertext, up to 20 parts of 700,000 characters.
    match /users/{uid}/arise/{part} {
      allow read, delete: if owner(uid) && part.matches('part[0-9]{1,2}');
      allow write: if owner(uid)
        && part.matches('part([0-9]|1[0-9])')
        && request.resource.data.keys().hasOnly(['rev', 'ct'])
        && shortString(request.resource.data.rev, 32)
        && shortString(request.resource.data.ct, 700000);
    }

    // For a forgotten password: the Firebase password, sealed with the recovery code. Useless
    // without that code, so anyone may fetch one by its login email (no listing). Only the
    // account with that email can write it, so nobody can take someone else's. `email: true`
    // says the account uses Email reset, so the app knows before signing in.
    match /recovery/{email} {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['uid', 'auth', 'email'])
        && request.resource.data.uid == request.auth.uid
        && sealed(request.resource.data.auth, 400)
        && (!('email' in request.resource.data) || request.resource.data.email == true);
      allow delete: if request.auth != null && request.auth.token.email == email;
    }
  }
}
