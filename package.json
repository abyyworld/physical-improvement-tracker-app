{
  "name": "arise",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Arise: daily quests toward any goal, with a private AI coach. Installable web app, plus an optional iOS shell built with Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "check": "npm run typecheck && npm test && npm run build",
    "ios:sync": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "fflate": "0.8.2",
    "firebase": "^12.19.0",
    "tinfoil": "1.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
