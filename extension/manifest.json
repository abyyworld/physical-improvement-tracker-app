{
  "manifest_version": 3,
  "name": "Arise",
  "version": "1.0.0",
  "description": "A private log of the sites you visit and what you search, for your Arise app. Sealed in the browser, so only your Arise can read it.",
  "homepage_url": "https://abyyworld.github.io/physical-improvement-tracker-app/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Arise",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["history", "tabs", "idle", "alarms", "storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://abyyworld.github.io/physical-improvement-tracker-app/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "incognito": "not_allowed",
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
